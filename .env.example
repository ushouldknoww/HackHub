# Copy to .env for local Docker Compose use. Change all passwords/secrets before exposure.
POSTGRES_DB=hackhub
POSTGRES_USER=hackhub
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
APP_PORT=8080

# At least 32 UTF-8 bytes. Never reuse the documented local development value in production.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRATION_SECONDS=3600
HACKHUB_STAFF_REGISTRATION_KEY=replace-with-a-long-random-provisioning-key

# Optional: leave blank to disable real email sending locally.
HACKHUB_MAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
